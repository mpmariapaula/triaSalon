            >
              {item.label}
            </a>
          ))}
          <a
            href="https://www.instagram.com/_triasalon/"
            target="_blank"
            rel="noopener noreferrer"
            className="flex items-center gap-2 text-[11px] tracking-[0.18em] uppercase text-muted hover:text-cream transition-colors"
